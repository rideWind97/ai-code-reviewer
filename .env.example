# --- AI 服务配置 (DeepSeek) ---
AI_PROVIDER=DeepSeek
# 你的 API Key
AI_API_KEY=DeepSeekAPIKey
# DeepSeek 官方 API 地址
AI_BASE_URL=https://api.deepseek.com
# 模型名称 (deepseek-chat 为 V3 版本，deepseek-coder 为代码专用)
AI_MODEL=deepseek-coder

# GitHub
GITHUB_TOKEN=token    # 个人访问令牌 (PAT)
GITHUB_WEBHOOK_SECRET=your_secret    # Webhook 签名密钥


# --- 审查规则 ---
# 目标分支 (逗号分隔)
TARGET_BRANCHES=main,master,develop
# 忽略的文件类型或路径
IGNORE_PATTERNS=package-lock.json,dist,node_modules,yarn.lock

# 审查语言 (zh-CN, en, ja, etc.)
REVIEW_LANGUAGE=zh-CN

# 是否跳过草稿状态的 PR (true/false)
SKIP_DRAFT_PR=true